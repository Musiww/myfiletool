{
  "name": "myfiletool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/pdf-assets.mjs --optional && node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node scripts/pdf-assets.mjs && node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node --test scripts/core.test.mjs",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "24.9.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "^7.3.8"
  }
}
